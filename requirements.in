# pip/uv mengambil versi CPU dari PyPI dan GPU tidak terpakai.
# Lihat docs/PANDUAN_MINGGU2.md langkah 3.

# --- parsing & ingest (Minggu 3-4)
docling
pypdf
pdfplumber        # hanya pembanding Docling untuk Bab 4 (tugas 3.9), bukan bagian pipeline

# --- retrieval (Minggu 5-7)
sentence-transformers
chromadb
rank-bm25

# --- LLM & agent (Minggu 9-16)
langchain
langchain-core
langchain-groq
langchain-community==0.4.1   # DIKUNCI -- lihat catatan di bawah
langchain-experimental
langchain-text-splitters
langgraph

# --- web search (Minggu 13) & LLM judge (Minggu 17)
tavily-python
langchain-google-genai

# --- evaluasi & hasil (Minggu 17-20)
ragas
datasets
pandas
openpyxl
matplotlib

# --- antarmuka bot Telegram (Minggu 16) -- menggantikan Chainlit (27-10-2026)
python-telegram-bot

# --- utilitas
python-dotenv

