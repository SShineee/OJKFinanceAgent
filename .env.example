# Template -- SALIN file ini jadi `.env` lalu isi nilainya. Jangan di-rename:
# file ini harus tetap ada (dan ikut ter-commit) sebagai daftar variabel yang dibutuhkan.
#
#   Copy-Item .env.example .env   (PowerShell)
#
# `.env` sudah masuk .gitignore -- JANGAN pernah di-commit, dan jangan pernah
# ditempel ke chat / screenshot / lampiran skripsi.

# --- WAJIB ---
# Model sistem (4 agent + baseline). Ambil key di https://console.groq.com/keys
GROQ_API_KEY=gsk_isi_disini

# --- WAJIB mulai Minggu 13 (Market Observer Agent) ---
# Pencarian web. Daftar di https://tavily.com  (free tier 1000 request/bulan)
TAVILY_API_KEY=tvly-isi_disini

# --- WAJIB mulai Minggu 17 (evaluasi RAGAS) ---
# LLM judge. Sengaja beda penyedia dengan model sistem supaya tidak ada
# bias self-preference. Ambil di https://aistudio.google.com/apikey
GOOGLE_API_KEY=isi_disini

# --- WAJIB mulai Minggu 16 (bot Telegram) ---
# Token dari @BotFather di Telegram.
TELEGRAM_BOT_TOKEN=isi_disini
# User ID Telegram yang BOLEH memakai bot, dipisah koma. Tanpa ini siapa pun yang
# menemukan bot bisa memakainya -- dan menghabiskan kuota Groq Anda.
# Cari ID Anda dengan mengirim pesan ke @userinfobot.
TELEGRAM_ALLOWED_USERS=isi_disini
# Untuk Local Bot API Server (Docker) -- supaya bot bisa menerima PDF > 20 MB.
# Ambil di https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=isi_disini
TELEGRAM_API_HASH=isi_disini

# --- OPSIONAL ---
# Judge kedua untuk cross-check (lihat Minggu 17 di ROADMAP). Perlu top-up.
# OPENAI_API_KEY=sk-isi_disini
